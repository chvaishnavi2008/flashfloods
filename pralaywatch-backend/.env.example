# PralayWatch Phase 1 Environment Configuration Template
FLASK_APP=run.py
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=your-secure-secret-key-here

# Database Configuration
DATABASE_URL=sqlite:///pralaywatch.db
# PostgreSQL Example:
# DATABASE_URL=postgresql://user:password@localhost:5432/pralaywatch_db

# Server Configuration
PORT=5000
HOST=0.0.0.0
CORS_ORIGINS=*
